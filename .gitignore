# -----------------------------
# Dépendances & gestionnaires
# -----------------------------
node_modules/
.pnp/
.pnp.js

# -----------------------------
# Build & production
# -----------------------------
build/
dist/
.cache/
.temp/

# -----------------------------
# Environnements & secrets
# -----------------------------
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local

# -----------------------------
# Logs & diagnostics
# -----------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# -----------------------------
# Systèmes & OS
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# IDE & éditeurs
# -----------------------------
.vscode/
.idea/
*.swp
*.swo

# -----------------------------
# Tests & couverture
# -----------------------------
coverage/

# -----------------------------
# Assets générés automatiquement
# -----------------------------
*.cache
*.tmp

# -----------------------------
# Fichiers propriétaires Codexium
# (ne jamais versionner)
# -----------------------------
/private/
/confidential/
/internal_docs/
